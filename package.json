{
  "name": "@craf-te/filmer",
  "description": "JavaScript/TypeScript requestAnimationFrame manager.",
  "version": "1.0.5",
  "author": "CRAF'TE",
  "bugs": "https://github.com/craf-te/filmer/issues",
  "devDependencies": {
    "@biomejs/biome": "^2.5.3",
    "@changesets/changelog-github": "^0.7.0",
    "@changesets/cli": "^2.31.0",
    "typescript": "~7.0.2",
    "vite": "^8.1.4",
    "vitest": "^4.1.10"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": {
      "require": "./dist/index.umd.cjs",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "homepage": "https://github.com/craf-te/filmer",
  "keywords": [
    "animation",
    "raf",
    "requestAnimationFrame",
    "typescript"
  ],
  "license": "MIT",
  "main": "./dist/index.umd.cjs",
  "module": "./dist/index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craf-te/filmer.git"
  },
  "scripts": {
    "build": "npm run lint:fix && vitest run && vite build && tsc --project tsconfig.build.json",
    "changeset": "changeset",
    "dev": "vite",
    "format": "biome format src --write",
    "lint": "biome check src",
    "lint:fix": "biome check src --write",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "release": "changeset publish",
    "test": "vitest",
    "version-packages": "changeset version"
  },
  "type": "module",
  "types": "./dist/index.d.ts"
}
